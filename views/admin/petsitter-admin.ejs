<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>펫시터 관리 페이지</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Jua&display=swap');

      * {
