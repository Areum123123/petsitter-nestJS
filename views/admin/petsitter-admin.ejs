        font-weight: 400;
        font-style: normal;
      }
      .main {
        color: rgb(35, 34, 34);

        background-image: url('main.jpg');
        background-position: center;
        background-size: cover;
        height: 60vh; /* 뷰포트의 100% 높이로 설정 */
      }

      body {
